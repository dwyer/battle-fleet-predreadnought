# Copy this file to .env and fill it in.

# The domain name that points at your home server (a free DuckDNS name works, e.g. battlefleet.duckdns.org).
# Caddy uses it to get the HTTPS certificate. The game then connects to wss://<this domain>
DOMAIN=battlefleet.example.org

# Optional: only let these web pages connect (comma-separated). "null" is the game opened straight from a file.
# Leave empty to allow any page.
ALLOWED_ORIGINS=https://dwyer.github.io,null

# Optional: the port the relay listens on at 127.0.0.1, for a reverse proxy of your own instead of Caddy.
# RELAY_PORT=8080
