# Optional: copy this file to .env to change any of these. The defaults work as they are if your Traefik setup matches.

# The domain Traefik routes to the relay. The game connects to wss://<this domain>
DOMAIN=battle-fleet-relay.dwyer.dev

# The Docker network your Traefik container is on, and its HTTPS entrypoint.
TRAEFIK_NETWORK=traefik-public
TRAEFIK_ENTRYPOINT=websecure

# Which web pages may connect (comma-separated). "null" is the game opened straight from a file.
# Set it empty (ALLOWED_ORIGINS=) to allow any page.
ALLOWED_ORIGINS=https://dwyer.github.io,null
